# ==============================================================================
# ChangeScope Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the 'backend' directory for local development:
#   cp .env.example .env
#
# NOTE: Spring Boot does NOT automatically load '.env' files.
# Export variables into your shell session before starting the application, e.g.:
#   set -a && source .env && set +a && ./mvnw spring-boot:run
# Or use inline export:
#   env $(grep -v '^#' .env | xargs) ./mvnw spring-boot:run
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Port the Spring Boot backend listens on (defaults to 8081)
PORT=8081

# ------------------------------------------------------------------------------
# 2. Database Configuration (Required for startup)
# ------------------------------------------------------------------------------
# PostgreSQL connection parameters.
# The database must exist before starting the application (e.g., 'createdb changescope').
DB_HOST=localhost
DB_PORT=5432
DB_NAME=changescope
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Full JDBC URL override (Optional - overrides DB_HOST, DB_PORT, and DB_NAME if set)
# DB_URL=jdbc:postgresql://localhost:5432/changescope

# Hibernate DDL generation mode (defaults to 'update')
# Allowed values: none, validate, update, create, create-drop
JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 3. Analysis Lifecycle Configuration (Optional)
# ------------------------------------------------------------------------------
# Duration after which an uncompleted RUNNING analysis is marked FAILED (defaults to 30m)
ANALYSIS_STALE_TIMEOUT=30m

# Interval between scheduled background reconciliation runs (defaults to 5m)
ANALYSIS_RECONCILIATION_INTERVAL=5m

# ------------------------------------------------------------------------------
# 4. GitHub Integration Configuration (Optional for local startup)
# ------------------------------------------------------------------------------
# The application starts and runs locally without GitHub credentials.
# GitHub settings are only needed for live PR fetching, webhook verification,
# or GitHub App authentication.

# GitHub REST API base URL (defaults to https://api.github.com)
# Change only if using GitHub Enterprise Server or an API mock server.
GITHUB_API_BASE_URL=https://api.github.com

# --- Option A: Personal Access Token (PAT) Fallback ---
# Classic PAT or fine-grained token with 'repo' read access for local development.
# Used when GitHub App authentication is not configured.
GITHUB_TOKEN=

# --- Option B: GitHub App Authentication (Primary) ---
# Used for production or authenticating as a GitHub App installation.
# Requires GITHUB_APP_ID and either GITHUB_PRIVATE_KEY or GITHUB_PRIVATE_KEY_PATH.
GITHUB_APP_ID=

# GitHub App RSA private key in PEM format (inline string, newline-escaped)
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Path to the GitHub App private key .pem file on disk
# GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Optional default GitHub App installation ID.
# Note: Repositories registered in ChangeScope typically define their own installation ID.
# This variable serves only as an optional fallback when a repository does not specify one.
GITHUB_INSTALLATION_ID=

# --- GitHub Webhooks ---
# Secret used to verify HMAC-SHA256 signatures (X-Hub-Signature-256) on incoming webhooks.
# Required only if receiving webhook events at /api/v1/webhooks/github.
GITHUB_WEBHOOK_SECRET=
